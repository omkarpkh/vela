{
  "name": "@omkarux/vela",
  "version": "0.9.0",
  "description": "A token-first design system: framework-agnostic tokens and component specs with a React implementation. Tokens compile to CSS, a Figma library, a Flutter theme and a Material UI theme from one source. Two-layer color architecture, separate severity and risk taxonomies, light and dark theming, WCAG AA asserted in CI, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Omkar Khadamkar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkarpkh/vela.git"
  },
  "homepage": "https://github.com/omkarpkh/vela#readme",
  "bugs": {
    "url": "https://github.com/omkarpkh/vela/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/vela.css",
    "./tokens.css": "./dist/tokens.css",
    "./guidelines/*": "./guidelines/*",
    "./package.json": "./package.json",
    "./tokens.json": "./tokens/vela.tokens.json",
    "./tokens.dart": "./flutter/lib/vela_tokens.dart",
    "./mui-theme.json": "./bridges/vela.mui-theme.json"
  },
  "files": [
    "dist",
    "guidelines",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tokens",
    "flutter/lib",
    "flutter/pubspec.yaml",
    "flutter/README.md",
    "bridges"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-tokens-dart.mjs && node scripts/build-tokens-mui.mjs",
    "tokens:dart": "node scripts/build-tokens-dart.mjs",
    "tokens:mui": "node scripts/build-tokens-mui.mjs",
    "tokens:figma": "node scripts/sync-figma.mjs",
    "tokens:figma:read": "node scripts/figma-drift.mjs --read",
    "tokens:figma:check": "node scripts/figma-drift.mjs",
    "guidelines:figma": "node scripts/sync-figma-descriptions.mjs",
    "figma:build": "node scripts/figma/build-components.mjs",
    "tokens:check": "npm run tokens && git diff --exit-code -- src/styles/tokens.light.css src/styles/tokens.dark.body.css flutter/lib/vela_tokens.dart flutter/pubspec.yaml bridges/vela.mui-theme.json",
    "build": "npm run clean && npm run tokens && npm run build:js && npm run build:css",
    "build:js": "vite build",
    "build:css": "node scripts/build-css.mjs",
    "predev": "npm run build:css",
    "dev": "vite --config vite.demo.config.ts",
    "predemo:build": "npm run build:css",
    "demo:build": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "screenshots": "DOCS=1 playwright test tests/visual/docs.spec.ts",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast-report.mjs",
    "verify": "npm run tokens:check && npm run typecheck && npm run test && npm run build && node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "component-library",
    "accessibility",
    "flutter",
    "dart",
    "web-components",
    "material-ui",
    "mui",
    "theme"
  ],
  "engines": {
    "node": ">=18"
  }
}
